datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Tier {
  STANDARD
  PREMIUM
}

enum OrderStatus {
  PLACED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum RefundReason {
  DAMAGED
  WRONG_ITEM
  NOT_AS_DESCRIBED
  CHANGED_MIND
  NEVER_ARRIVED
  UNSPECIFIED
}

enum Decision {
  APPROVED
  DENIED
  ESCALATED
}

model Customer {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  tier           Tier            @default(STANDARD)
  riskFlag       Boolean         @default(false) // seeded abuse signal
  createdAt      DateTime        @default(now())
  orders         Order[]
  refundRequests RefundRequest[]
}

model Order {
  id             String          @id @default(uuid())
  orderNumber    String          @unique // human-quotable, e.g. WN-10423
  customerId     String
  totalAmount    Decimal         @db.Decimal(10, 2)
  currency       String          @default("USD")
  status         OrderStatus
  isFinalSale    Boolean         @default(false)
  deliveredAt    DateTime?
  placedAt       DateTime
  customer       Customer        @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  refundRequests RefundRequest[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  name      String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id])
}

model RefundRequest {
  id               String        @id @default(uuid())
  customerId       String
  orderId          String?
  rawMessage       String        // exactly what the customer typed
  classifiedIntent String?       // AI output
  claimedReason    RefundReason? // AI output, validated
  decision         Decision
  decisionReason   String        // deterministic, rule-derived
  customerReply    String        // AI-drafted, policy-constrained
  policyTrace      Json          // every rule + verdict
  aiTrace          Json          // model, tokens, latency, raw
  injectionFlag    Boolean       @default(false)
  createdAt        DateTime      @default(now())
  customer         Customer      @relation(fields: [customerId], references: [id])
  order            Order?        @relation(fields: [orderId], references: [id])
}
